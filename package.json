{
  "name": "ouro-monorepo",
  "private": true,
  "version": "0.0.0",
  "description": "OURO: an open-source TypeScript SDK for recursive self-improvement. Superintelligence you can switch off.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/**\" run build",
    "test": "pnpm -r --filter \"./packages/**\" run test",
    "lint": "eslint .",
    "site": "node scripts/serve-site.mjs",
    "typecheck": "pnpm -r --filter \"./packages/**\" run typecheck",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.5",
    "@eslint/js": "^9.39.0",
    "@types/node": "^22.18.0",
    "eslint": "^9.39.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^3.2.7"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "isolated-vm"
    ]
  }
}
