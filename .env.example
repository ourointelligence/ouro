# Which LLM adapter the loop uses: anthropic (default), openai, gemini or ollama.
OURO_LLM=
# Model override for the chosen adapter (defaults: claude-sonnet-5-5, gpt-4o, gemini-2.0-flash, llama3.1).
OURO_MODEL=
# Key for the anthropic adapter.
ANTHROPIC_API_KEY=
# Key for the openai adapter (optional when OPENAI_BASE_URL points at a local server).
OPENAI_API_KEY=
# Any OpenAI-compatible endpoint for the openai adapter (LM Studio, vLLM, OpenRouter).
OPENAI_BASE_URL=
# Key for the gemini adapter.
GEMINI_API_KEY=
# Ollama server for the ollama adapter (default http://localhost:11434).
OLLAMA_URL=
