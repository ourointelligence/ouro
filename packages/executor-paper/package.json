{
  "name": "@ourointelligence/executor-paper",
  "version": "0.2.0",
  "description": "OURO paper Executor plugin: fills at next bar open with fees and slippage, one position per strategy per asset, outcomes with bar-by-bar drawdown.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ourointelligence/ouro.git",
    "directory": "packages/executor-paper"
  },
  "homepage": "https://ourosi.xyz",
  "bugs": {
    "url": "https://github.com/ourointelligence/ouro/issues"
  },
  "keywords": [
    "self-improvement",
    "agents",
    "superintelligence",
    "trading",
    "sdk",
    "typescript"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@ourointelligence/sdk": "^0.2.0"
  },
  "devDependencies": {
    "@ourointelligence/sdk": "^0.2.0",
    "@types/node": "^22.18.0",
    "tsup": "^8.5.1",
    "vitest": "^3.2.7"
  }
}
